# Copy this file to .env and fill values locally. Every value is intentionally
# empty so this tracked template cannot be mistaken for usable configuration.

# Database
DATABASE_URL=
POSTGRES_PASSWORD=

# Developer workflow
SKIP_DB_PREPARE=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# App URLs
NEXT_PUBLIC_APP_URL=

# Mobile (Expo)
MOBILE_APP_API_URL=
MOBILE_APP_SCHEME=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_APP_SCHEME=
EAS_PROJECT_ID=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Billing (Paddle, optional)
NEXT_PUBLIC_PADDLE_ENV=
PADDLE_ENV=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
PADDLE_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# AI (OpenAI, optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Email (Resend, optional)
RESEND_API_KEY=
EMAIL_FROM=

# File storage (MinIO / S3-compatible, optional)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
UPLOAD_MAX_SIZE_MB=

# Scheduled jobs (Bearer token for /api/chain/reconcile; long random string)
CRON_SECRET=

# Identity verification (docs/IDENTITY.md). IDENTITY_PROVIDER is veriff, mock
# (development only, refused in production), or empty to switch verification off.
IDENTITY_PROVIDER=
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_BASE_URL=

# On-chain Kudos and attestations on Base (docs/CHAIN.md). Off unless CHAIN_ENABLED=true.
# CHAIN_ID is 8453 (Base), 84532 (Base Sepolia), or 31337 (local Anvil).
CHAIN_ENABLED=
CHAIN_ID=
CHAIN_RPC_URL=
KUDOS_TOKEN_ADDRESS=
CREATIVE_REGISTRY_ADDRESS=
# Server-only hot key holding MINTER/REDEEMER/REGISTRAR/PAUSER. Never the admin key.
CHAIN_OPERATOR_PRIVATE_KEY=
# Secret salt for the pseudonymous account references written on-chain.
CHAIN_REF_SALT=
# ISO country codes allowed to move Kudos on-chain, comma-separated. Empty allows nobody.
CHAIN_ALLOWED_COUNTRIES=

# Contract deployment (packages/contracts/script/Deploy.s.sol). Public addresses only;
# pass the deployer key on the command line or via a Foundry keystore, never here.
KUDOS_ADMIN_ADDRESS=
CHAIN_OPERATOR_ADDRESS=
KUDOS_VAULT_ADDRESS=
KUDOS_SUPPLY_CAP=
