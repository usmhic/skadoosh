# Copy this file to .env and fill values locally. Every value is intentionally
# empty so this tracked template cannot be mistaken for usable configuration.

# Database
DATABASE_URL=
POSTGRES_PASSWORD=

# Developer workflow
SKIP_DB_PREPARE=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# App URLs
NEXT_PUBLIC_APP_URL=

# Mobile (Expo)
MOBILE_APP_API_URL=
MOBILE_APP_SCHEME=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_APP_SCHEME=
EAS_PROJECT_ID=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Billing (Paddle, optional)
NEXT_PUBLIC_PADDLE_ENV=
PADDLE_ENV=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
PADDLE_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# AI (OpenAI, optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Email (Resend, optional)
RESEND_API_KEY=
EMAIL_FROM=

# File storage (MinIO / S3-compatible, optional)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
UPLOAD_MAX_SIZE_MB=
