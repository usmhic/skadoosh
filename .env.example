# Local development; keep secrets in .env only.

# Local ports
WEB_PORT=3000
API_PORT=3000
EXPO_PORT=8081
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Database
DATABASE_URL=
POSTGRES_PASSWORD=
SKIP_DB_PREPARE=false

# Auth and web
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mobile
MOBILE_APP_API_URL=http://localhost:3000
MOBILE_APP_SCHEME=skaddosh
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_SCHEME=skaddosh
EAS_PROJECT_ID=001bbc18-9439-4d57-8c38-8348a0a444b1

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Billing (optional)
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
PADDLE_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# AI and email (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM="skaddosh <noreply@skaddosh.local>"

# Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=skaddosh
MINIO_SECRET_KEY=
MINIO_BUCKET=skaddosh
UPLOAD_MAX_SIZE_MB=12

# Travel collections (docs/TRAVEL.md). ORS_API_KEY is a HeiGIT/OpenRouteService key, server-only;
# without it, place search is off and journeys are straight lines. ORS_BASE_URL is a self-hosted ORS.
ORS_API_KEY=
ORS_BASE_URL=
# Public map tiles (no secrets). Defaults to the OpenStreetMap standard layer.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Scheduled jobs (Bearer token for /api/chain/reconcile; long random string)
CRON_SECRET=

# Identity verification (docs/IDENTITY.md). IDENTITY_PROVIDER is veriff, mock
# (development only, refused in production), or empty to switch verification off.
IDENTITY_PROVIDER=
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_BASE_URL=

# On-chain Kudos and attestations on Base (docs/CHAIN.md). Off unless CHAIN_ENABLED=true.
# CHAIN_ID is 8453 (Base), 84532 (Base Sepolia), or 31337 (local Anvil).
CHAIN_ENABLED=
CHAIN_ID=
CHAIN_RPC_URL=
KUDOS_TOKEN_ADDRESS=
CREATIVE_REGISTRY_ADDRESS=
# Server-only hot key holding MINTER/REDEEMER/REGISTRAR/PAUSER. Never the admin key.
CHAIN_OPERATOR_PRIVATE_KEY=
# Secret salt for the pseudonymous account references written on-chain.
CHAIN_REF_SALT=
# ISO country codes allowed to move Kudos on-chain, comma-separated. Empty allows nobody.
CHAIN_ALLOWED_COUNTRIES=

# Contract deployment (packages/contracts/script/Deploy.s.sol). Public addresses only;
# pass the deployer key on the command line or via a Foundry keystore, never here.
KUDOS_ADMIN_ADDRESS=
CHAIN_OPERATOR_ADDRESS=
KUDOS_VAULT_ADDRESS=
KUDOS_SUPPLY_CAP=
