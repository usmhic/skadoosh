{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.1",
      "env": { "NODE_ENV": "production" },
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "test": {
      "distribution": "store",
      "node": "22.13.1",
      "env": { "NODE_ENV": "production" },
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "open-testing": {
      "distribution": "store",
      "node": "22.13.1",
      "env": { "NODE_ENV": "production" },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "distribution": "store",
      "node": "22.13.1",
      "env": { "NODE_ENV": "production" },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "test": {
      "ios": {},
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "open-testing": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {},
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
