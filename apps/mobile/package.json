{
  "name": "@skaddosh/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start --port 8081",
    "dev:with-db": "pnpm db:sync && expo start --port 8081",
    "db:sync": "pnpm --filter @skaddosh/db db:push && pnpm --filter @skaddosh/db db:seed",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "doctor": "npx expo-doctor",
    "verify:release": "tsc --noEmit && expo export --platform android --output-dir dist --clear",
    "eas-build-post-install": "pnpm run verify:release"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.3",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@skaddosh/api": "workspace:*",
    "@skaddosh/auth": "workspace:*",
    "@skaddosh/db": "workspace:*",
    "@skaddosh/i18n": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "better-auth": "1.7.3",
    "expo": "^55.0.31",
    "expo-auth-session": "^55.0.18",
    "expo-linking": "^55.0.17",
    "expo-localization": "^55.0.19",
    "expo-secure-store": "^55.0.18",
    "expo-web-browser": "^55.0.20",
    "i18next": "25.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "15.7.4",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "superjson": "1.13.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@skaddosh/typescript-config": "workspace:*",
    "@types/node": "22.0.0",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~55.0.25",
    "typescript": "5.9.3"
  }
}
