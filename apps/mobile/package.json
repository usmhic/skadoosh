{
  "name": "@skaddosh/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start --port 8081",
    "dev:with-db": "pnpm db:sync && expo start --port 8081",
    "db:sync": "pnpm --filter @skaddosh/db db:push && pnpm --filter @skaddosh/db db:seed",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.10",
