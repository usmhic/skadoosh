    "@react-navigation/native-stack": "^7.0.0",
    "@skaddosh/api": "workspace:*",
    "@skaddosh/auth": "workspace:*",
    "@skaddosh/db": "workspace:*",
    "@skaddosh/i18n": "workspace:*",
    "@tanstack/react-query": "5.100.9",
    "@trpc/client": "11.0.0",
    "@trpc/react-query": "11.0.0",
    "better-auth": "1.6.10",
    "expo": "^55.0.31",
    "expo-auth-session": "^55.0.18",
    "expo-linking": "^55.0.17",
    "expo-localization": "^55.0.19",
    "expo-secure-store": "^55.0.18",
    "expo-web-browser": "^55.0.20",
    "i18next": "25.6.0",
