{
  "name": "@skaddosh/db",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./schema":    "./src/schema.ts",
    "./seed-data": "./src/seed-data.ts",
    "./migrate":   "./src/migrate.ts",
    "./seed":      "./src/seed.ts"
  },
  "scripts": {
    "db:generate": "node ../../scripts/with-root-env.mjs drizzle-kit generate",
    "db:migrate": "node ../../scripts/with-root-env.mjs tsx src/migrate.ts",
    "db:push": "node ../../scripts/with-root-env.mjs tsx src/ensure-db.ts && node ../../scripts/with-root-env.mjs drizzle-kit push",
    "db:seed": "node ../../scripts/with-root-env.mjs tsx src/seed.ts",
    "db:studio": "node ../../scripts/with-root-env.mjs drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@skaddosh/typescript-config": "workspace:*",
    "@types/node": "22.0.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
